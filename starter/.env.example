# AstroPress database settings
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=astropress
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_TABLE_PREFIX=wp_

# AstroPress internal dev runtime listeners
# The public site URL is WP_URL, used by astropress.config.ts.
# Leave these as auto unless you are debugging AstroPress internals.
WP_URL=http://localhost:3000
ASTROPRESS_PROXY_HOST=
ASTROPRESS_PROXY_PORT=auto
ASTROPRESS_PHP_HOST=127.0.0.1
ASTROPRESS_PHP_PORT=auto
ASTROPRESS_ASTRO_HOST=127.0.0.1
ASTROPRESS_ASTRO_PORT=auto
